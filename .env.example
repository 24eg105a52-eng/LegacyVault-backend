# ==============================================================================
# LegacyVault Backend Environment Configuration
# ==============================================================================
# Copy this file to .env for local usage. Never commit real secrets to GitHub!

# Server Port (Render dynamically injects PORT)
PORT=8080

# Database Configuration
# OPTION A (Render PostgreSQL): Render provides DATABASE_URL automatically.
# Example: postgres://username:password@dpg-xxxxxx.oregon-postgres.render.com/legacy_vault
# DATABASE_URL=

# OPTION B (Individual PostgreSQL parameters):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=legacy_vault
# DB_USERNAME=postgres
# DB_PASSWORD=your_secure_password

# OPTION C (Local MySQL default fallback in application.properties):
# DB_USERNAME=root
# DB_PASSWORD=your_mysql_password

# Security & JWT Configuration (Generate 64+ char key)
JWT_SECRET=YourSuperSecret64CharacterKeyMustBeLongEnoughForHMACSHA256Signature2026
JWT_EXPIRATION_MS=86400000

# Vault AES-256-GCM Encryption Secret (Permanent master secret)
VAULT_ENCRYPTION_SECRET=YourMasterEncryptionSecretKeyAES256GCMProductionValue2026

# Vault Storage Directory (Mount path on Render Persistent Disk)
VAULT_STORAGE_DIR=/var/data/vault_files

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=https://legacyvault.vercel.app,https://*.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Email (SMTP) Configuration (Optional)
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=your_sendgrid_api_key
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=notifications@legacyvault.com
